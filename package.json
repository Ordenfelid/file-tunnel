{
  "name": "file-tunnel",
  "version": "0.1.7",
  "type": "module",
  "description": "SiYuan plugin: lets the Agent correctly read binary files (images etc.) returned by MCP instead of base64 flooding the context, and upload local asset files into MCP requests as base64",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development vite build --watch",
    "build": "cross-env NODE_ENV=production vite build",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "cross-env": "^10.1.0",
    "siyuan": "1.2.7",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-static-copy": "^4.1.1",
    "vite-plugin-zip-pack": "^1.2.4"
  }
}
